# SearchLab engine URL used by the frontend at build time.
#
# Local development (leave unset; defaults to the local engine):
#   VITE_ENGINE_URL=http://127.0.0.1:8000
#
# Vercel (frontend + Python engine in one deployment, same origin):
#   VITE_ENGINE_URL=/api
#
#   The Python function lives in api/index.py and is reachable at /api.
#   Vercel has no JDK, so Java is hidden there; Python works in both modes.
#
# Separate engine host (Python + JDK, all features including Java):
#   VITE_ENGINE_URL=https://searchlab-engine.fly.dev
#
# Copy this file to `.env` for local overrides (`.env` is git-ignored).
VITE_ENGINE_URL=http://127.0.0.1:8000
